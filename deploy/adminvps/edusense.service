[Unit]
Description=EduSense FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/edusense
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/edusense/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
