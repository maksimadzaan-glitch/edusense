AI_PROVIDER=gigachat

# GigaChat (Сбер) — ключ авторизации из кабинета разработчика
GIGACHAT_CREDENTIALS=вставьте_ключ_авторизации_сюда
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Для чтения фото решений лучше GigaChat-2-Pro или GigaChat-2-Max (vision)
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=false

# Опционально: DeepSeek (если AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Опционально: OpenAI-compatible (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Universal PostgreSQL-генерация (отдельно от SQLite edusense.db)
# Без POSTGRES_URL эндпоинт /api/universal/generate вернёт 503
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edusense_universal

# Опционально: Telegram Bot (Mini App). Не обязателен для UI.
# Позже — проверка WebApp initData. См. DEPLOY_MINIAPP.md
TELEGRAM_BOT_TOKEN=
